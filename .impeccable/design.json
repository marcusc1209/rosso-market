  "rules": [
   {
    "name": "The Two Inks Rule",
    "body": "Cobalt means asking and vermilion means sold, everywhere. Overlap comes from blending, never a painted third colour.",
    "section": "colors"
   },
   {
    "name": "The Yellow Is Not Data Rule",
    "body": "Giallo marks shell, selection, liveness and this car. Never a price.",
    "section": "colors"
   }
  ],
  "dos": [
