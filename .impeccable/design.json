 "narrative": {
  "northStar": "Overprint",
  "overview": "Asks in cobalt and sales in vermilion, printed over each other on white paper after Milan racing print of the 1950s and 60s. Where they overlap they turn violet: where the market clears.",
  "keyCharacteristics": [
   "Two data inks with blended overlap",
   "Yellow header band",
   "One variable family, expanded for titles",
   "Hairline rules and square corners",
   "Standard controls"
